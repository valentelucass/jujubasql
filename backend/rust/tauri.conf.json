{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JujubaSQL",
  "version": "0.1.15",
  "identifier": "br.nexosql.studio",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../frontend" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../frontend" },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "JujubaSQL", "width": 1380, "height": 850, "minWidth": 880, "minHeight": 610, "backgroundColor": "#0c130f" }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwN0Q1RUM2QjA4Nzk0REYKUldUZmxJZXd4bDU5Z0Z2ZE14U3loMStGUWJ4aTBQNlh6N2FiN1dyTUpnek9QdzNhVVNvZU04UHIK",
      "endpoints": ["https://github.com/valentelucass/jujubasql/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"], "windows": { "nsis": { "installerIcon": "icons/icon.ico", "installMode": "currentUser", "languages": ["PortugueseBR", "English"] } } }
}
